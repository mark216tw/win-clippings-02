    <RootNamespace>Clippings.App</RootNamespace>
    <AssemblyName>Clippings.App.New</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clippings.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clippings.Core\Clippings.Core.csproj" />
