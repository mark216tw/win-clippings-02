<Window x:Class="Clippings.App.Views.AnnotationToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clippings 標註工具列"
        Icon="/Assets/clippings.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        Closed="OnClosed"
        KeyDown="OnKeyDown">

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Background="{DynamicResource ToolbarBrush}"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
            </Border.Effect>
        </Border>
        <Border x:Name="BarRoot"
                Background="Transparent"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6"
                SnapsToDevicePixels="True"
                MouseLeftButtonDown="OnBarMouseDown">
        <StackPanel>
            <DockPanel>
                <Button x:Name="ExitButton" DockPanel.Dock="Right" Style="{StaticResource AnnotateIconButtonStyle}"
                        Click="OnExitClick" ToolTip="結束標註 (Esc)" AutomationProperties.Name="結束標註">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <StackPanel Orientation="Horizontal">
                <Grid x:Name="DragGrip"
                      Width="18"
                      Margin="2,0,4,0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      ToolTip="拖曳移動工具列"
                      AutomationProperties.Name="移動工具列"
                      MouseLeftButtonDown="OnDragGripDown">
                    <UniformGrid Columns="2" Rows="3" Width="8" Height="16">
                        <Ellipse Width="2" Height="2" Fill="#88FFFFFF" Margin="1" />
                        <Ellipse Width="2" Height="2" Fill="#88FFFFFF" Margin="1" />
                        <Ellipse Width="2" Height="2" Fill="#88FFFFFF" Margin="1" />
                        <Ellipse Width="2" Height="2" Fill="#88FFFFFF" Margin="1" />
                        <Ellipse Width="2" Height="2" Fill="#88FFFFFF" Margin="1" />
                        <Ellipse Width="2" Height="2" Fill="#88FFFFFF" Margin="1" />
                    </UniformGrid>
                </Grid>

                <Border Width="1" Margin="2,4" Background="#33FFFFFF" />

                <RadioButton x:Name="PenButton" GroupName="AnnotateTool" Tag="Pen" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="畫筆（2、P）" AutomationProperties.Name="畫筆">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M2,14 L5,13 L14,4 L12,2 L3,11 Z M10.5,3.5 L12.5,5.5"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="HighlighterButton" GroupName="AnnotateTool" Tag="Highlighter" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="螢光筆（3、H）" AutomationProperties.Name="螢光筆">
                    <Viewbox Width="16" Height="16">
                        <Grid Width="16" Height="16">
                            <Path Width="16" Height="16" Data="M2.5,3 L9.5,3 L9.5,9 L2.5,9 Z M9.5,4 L14,6 L14,7 L9.5,9 Z M5,3 L5,9"
                                  Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                            <Path Width="16" Height="16" Data="M2,12.5 L14,12.5"
                                  Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Opacity="0.5" />
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="LineButton" GroupName="AnnotateTool" Tag="Line" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="直線（4、N）" AutomationProperties.Name="直線">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M2,14 L14,2"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="ArrowButton" GroupName="AnnotateTool" Tag="Arrow" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="箭頭（5、A）" AutomationProperties.Name="箭頭">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M1,14 L14,1 M7,1 L14,1 L14,8"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="RectangleButton" GroupName="AnnotateTool" Tag="Rectangle" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="矩形（6、R）" AutomationProperties.Name="矩形">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M2,3 L14,3 L14,13 L2,13 Z"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="EllipseButton" GroupName="AnnotateTool" Tag="Ellipse" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="橢圓（7、O）" AutomationProperties.Name="橢圓">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M15,8 A7,5 0 1 1 1,8 A7,5 0 1 1 15,8"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="MagnifierButton" GroupName="AnnotateTool" Tag="Magnifier" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="放大鏡：游標處局部放大（M，滾輪縮放）" AutomationProperties.Name="放大鏡">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 M10.2,10.2 L14.5,14.5"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="EraserButton" GroupName="AnnotateTool" Tag="Eraser" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="橡皮擦：拖曳擦除整筆筆畫（8、E）" AutomationProperties.Name="橡皮擦">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M5.75,13.75 L12.75,6.75 L9.25,3.25 L2.25,10.25 Z M7.15,5.35 L10.65,8.85 M2,14.75 L3.5,14.75 M1.5,12.25 L2.5,13.25"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="LaserButton" GroupName="AnnotateTool" Tag="Laser" Style="{StaticResource AnnotateToolToggleStyle}"
                             Foreground="{DynamicResource ToolbarTextBrush}"
                             Click="OnToolClick" ToolTip="雷射筆：移動游標顯示漸隱軌跡，不留痕跡（1、L）"
                             AutomationProperties.Name="雷射筆">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M8,1 L9.6,6.4 L15,8 L9.6,9.6 L8,15 L6.4,9.6 L1,8 L6.4,6.4 Z"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </RadioButton>

                <Border Width="1" Margin="4,4" Background="#33FFFFFF" />

                <Button x:Name="VisibilityButton" Style="{StaticResource AnnotateIconButtonStyle}"
                        Click="OnVisibilityClick" ToolTip="顯示／隱藏標註（9、V）" AutomationProperties.Name="顯示或隱藏標註">
                    <Viewbox Width="16" Height="16">
                        <Grid Width="16" Height="16">
                            <Path x:Name="EyeVisiblePath" Width="16" Height="16"
                                  Data="M1,8 C3,4.5 5.5,3 8,3 C10.5,3 13,4.5 15,8 C13,11.5 10.5,13 8,13 C5.5,13 3,11.5 1,8 Z M8,6 A2,2 0 1 1 8,10 A2,2 0 1 1 8,6"
                                  Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                            <Path x:Name="EyeHiddenPath" Width="16" Height="16" Visibility="Collapsed"
                                  Data="M1,8 C3,4.5 5.5,3 8,3 C10.5,3 13,4.5 15,8 C13,11.5 10.5,13 8,13 C5.5,13 3,11.5 1,8 Z M8,6 A2,2 0 1 1 8,10 A2,2 0 1 1 8,6 M2,2 L14,14"
                                  Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Grid>
                    </Viewbox>
                </Button>

                <ToggleButton x:Name="PointerButton" Style="{StaticResource AnnotatePointerToggleStyle}"
                              Checked="OnPointerChecked" Unchecked="OnPointerUnchecked"
                              ToolTip="游標模式：點擊穿透到底下的應用程式，此模式無法繪圖（0、C）"
                              AutomationProperties.Name="游標模式">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M4,2 L4,13.5 L7,10.5 L9.2,14.5 L11.2,13.4 L9,9.5 L13,9.5 Z"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </ToggleButton>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Grid>
                    <Button x:Name="ColorMenuButton" Width="30" Height="26" Padding="0"
                            Background="#FF3B30" Click="OnColorMenuClick"
                            ToolTip="選擇標註顏色" AutomationProperties.Name="標註顏色">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorMenuButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="OnColorPopupClosed">
                        <Border Background="{DynamicResource ToolbarBrush}"
                                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2,0,2,8">
                                    <Ellipse x:Name="PopupCurrentColorSwatch" Width="22" Height="22" Fill="#FF3B30"
                                             Stroke="{DynamicResource ToolbarBorderBrush}" StrokeThickness="1" Margin="0,0,8,0" />
                                    <TextBlock Text="目前顏色" Foreground="{DynamicResource ToolbarTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <UniformGrid x:Name="SwatchGrid" Columns="8">
                                    <RadioButton Background="#FF3B30" Tag="FF3B30" GroupName="AnnotateColor" IsChecked="True" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="紅色" AutomationProperties.Name="紅色" />
                                    <RadioButton Background="#FF9500" Tag="FF9500" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="橘色" AutomationProperties.Name="橘色" />
                                    <RadioButton Background="#FFCC00" Tag="FFCC00" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="黃色" AutomationProperties.Name="黃色" />
                                    <RadioButton Background="#34C759" Tag="34C759" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="綠色" AutomationProperties.Name="綠色" />
                                    <RadioButton Background="#00C7BE" Tag="00C7BE" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="青色" AutomationProperties.Name="青色" />
                                    <RadioButton Background="#0A84FF" Tag="0A84FF" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="藍色" AutomationProperties.Name="藍色" />
                                    <RadioButton Background="#5856D6" Tag="5856D6" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="靛色" AutomationProperties.Name="靛色" />
                                    <RadioButton Background="#AF52DE" Tag="AF52DE" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="紫色" AutomationProperties.Name="紫色" />
                                    <RadioButton Background="#FF2D55" Tag="FF2D55" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="桃紅色" AutomationProperties.Name="桃紅色" />
                                    <RadioButton Background="#8B4513" Tag="8B4513" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="棕色" AutomationProperties.Name="棕色" />
                                    <RadioButton Background="#6E6E73" Tag="6E6E73" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="灰色" AutomationProperties.Name="灰色" />
                                    <RadioButton Background="#A8A8AD" Tag="A8A8AD" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="淺灰色" AutomationProperties.Name="淺灰色" />
                                    <RadioButton Background="#1B1F2A" Tag="1B1F2A" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="黑色" AutomationProperties.Name="黑色" />
                                    <RadioButton Background="#FFFFFF" Tag="FFFFFF" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="白色" AutomationProperties.Name="白色" />
                                    <RadioButton Background="#B8F2A1" Tag="B8F2A1" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="淺綠色" AutomationProperties.Name="淺綠色" />
                                    <RadioButton Background="#A7D8FF" Tag="A7D8FF" GroupName="AnnotateColor" Style="{StaticResource ColorSwatchStyle}" Checked="OnColorChecked" ToolTip="淺藍色" AutomationProperties.Name="淺藍色" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock x:Name="StrokeWidthLabel" Text="線寬" Foreground="{DynamicResource ToolbarTextBrush}"
                           FontSize="12" Margin="8,0,4,0" VerticalAlignment="Center" />
                <ComboBox x:Name="StrokeCombo" Width="72" SelectionChanged="OnStrokeChanged" ToolTip="線條粗細"
                          AutomationProperties.LabeledBy="{Binding ElementName=StrokeWidthLabel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} px}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock x:Name="BackdropLabel" Text="背景" Foreground="{DynamicResource ToolbarTextBrush}"
                           FontSize="12" Margin="8,0,4,0" VerticalAlignment="Center" />
                <ComboBox x:Name="BackdropCombo" Width="86" SelectionChanged="OnBackdropChanged" ToolTip="標註背景"
                          AutomationProperties.LabeledBy="{Binding ElementName=BackdropLabel}" />

                <Border Width="1" Margin="6,4" Background="#33FFFFFF" />

                <Button x:Name="UndoButton" Style="{StaticResource AnnotateIconButtonStyle}"
                        Click="OnUndoClick" ToolTip="復原 (Ctrl+Z)" AutomationProperties.Name="復原">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M5.5,3.5 L2,7 L5.5,10.5 M2,7 L9.5,7 A3.75,3.75 0 0 1 9.5,14.5"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource AnnotateIconButtonStyle}"
                        Click="OnRedoClick" ToolTip="重做 (Ctrl+Y)" AutomationProperties.Name="重做">
                    <Viewbox Width="16" Height="16">
                        <Path Width="16" Height="16" Data="M10.5,3.5 L14,7 L10.5,10.5 M14,7 L6.5,7 A3.75,3.75 0 0 0 6.5,14.5"
                              Stroke="{DynamicResource ToolbarTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Button>
                <Button x:Name="ClearButton" Content="清空" Style="{StaticResource OverlayToolbarButtonStyle}"
                        Click="OnClearClick" ToolTip="清除所有標註（可復原）" AutomationProperties.Name="清空標註" />

                <Border Width="1" Margin="6,4" Background="#33FFFFFF" />

                <Button Content="截圖" Style="{StaticResource OverlayToolbarButtonStyle}"
                        Click="OnCaptureClick" ToolTip="擷取含標註的全螢幕畫面並複製" AutomationProperties.Name="截圖" />
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
</Window>
