<UserControl x:Class="Clippings.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:Clippings.App.Strings"
             PreviewKeyDown="OnPagePreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="設定" Style="{StaticResource PageTitleStyle}" />
             <TextBlock Text="調整快捷鍵、擷取方式、儲存位置與外觀。"
                        Style="{StaticResource BodySecondaryStyle}"
                        Margin="0,4,0,20" />

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <CheckBox x:Name="StartupCheck" Content="開機時自動啟動（最小化到系統匣）" />
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外觀" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="主題" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="ThemeCombo" Width="160" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="快捷鍵" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="區域擷取" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="RegionHotkeyBox" Margin="0,0,0,10"
                                 GotKeyboardFocus="OnHotkeyGotKeyboardFocus"
                                 LostKeyboardFocus="OnHotkeyLostKeyboardFocus"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RegionHint"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="全螢幕擷取" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="FullScreenHotkeyBox" Margin="0,0,0,10"
                                 GotKeyboardFocus="OnHotkeyGotKeyboardFocus"
                                 LostKeyboardFocus="OnHotkeyLostKeyboardFocus"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="FullScreenHint"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,10" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="目前視窗擷取" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="WindowHotkeyBox" Margin="0,0,0,10"
                                 GotKeyboardFocus="OnHotkeyGotKeyboardFocus"
                                 LostKeyboardFocus="OnHotkeyLostKeyboardFocus"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="WindowHint"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,10" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="延遲擷取" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="DelayedHotkeyBox" Margin="0,0,0,10"
                                 GotKeyboardFocus="OnHotkeyGotKeyboardFocus"
                                 LostKeyboardFocus="OnHotkeyLostKeyboardFocus"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DelayedHint"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,10" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="螢幕標註" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AnnotateHotkeyBox"
                                 GotKeyboardFocus="OnHotkeyGotKeyboardFocus"
                                 LostKeyboardFocus="OnHotkeyLostKeyboardFocus"
                                 PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="AnnotateHint"
                                   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <TextBlock Text="點擊欄位後直接按下組合鍵。至少需要一個修飾鍵，例如 Ctrl+Shift+X、Alt+F1。"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="擷取" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="延遲秒數" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="DelayCombo" Width="100" />
                    </StackPanel>

                    <CheckBox x:Name="AutoCopyCheck" Content="擷取後自動複製到剪貼簿" Margin="0,14,0,0" />
                    <CheckBox x:Name="CaptureSoundCheck" Content="使用快捷鍵擷取完成時播放音效" Margin="0,10,0,0" />
                    <CheckBox x:Name="MagnifierCheck" Content="選取時顯示放大鏡與顏色資訊" Margin="0,10,0,0" />
                    <CheckBox x:Name="CaptureCursorCheck"
                              Content="{x:Static strings:AppStrings.CaptureCursor}"
                              ToolTip="{x:Static strings:AppStrings.CaptureCursorToolTip}"
                              Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="螢幕標註" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="開始標註時套用；結束標註時會記住當時的狀態。"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,10,0,0" />

                    <CheckBox x:Name="AnnotateClickThroughCheck"
                              Content="預設使用游標模式（點擊穿透到底下的應用程式）"
                              Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="背景" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="AnnotateBackdropCombo" Width="140" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="儲存" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="自動存檔資料夾" Margin="0,14,0,6" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="開啟"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    ToolTip="在檔案總管中開啟自動存檔資料夾"
                                    Click="OnOpenSaveFolderClick" />
                            <Button Content="瀏覽"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="OnBrowseClick" />
                        </StackPanel>
                        <TextBox x:Name="SaveDirBox" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="預設格式" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="FormatCombo" Width="120" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="JPEG 品質" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider x:Name="JpegQualitySlider"
                                Width="180"
                                Minimum="1"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnJpegQualityChanged" />
                        <TextBlock x:Name="JpegQualityText"
                                   Width="48"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="僅套用於 JPEG"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="SaveAutomaticallyCheck" Content="擷取後自動在資料夾留下一份圖檔" Margin="0,12,0,0" />

                    <TextBlock Text="資料位置" Style="{StaticResource CaptionStyle}" Margin="0,14,0,2" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="開啟"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="在檔案總管中開啟資料夾"
                                Click="OnOpenDataFolderClick" />
                        <TextBlock x:Name="LibraryPathText"
                                   Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="螢幕錄影" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="輸出資料夾（留白使用「影片\Clippings」）" Margin="0,14,0,6" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="開啟"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    ToolTip="在檔案總管中開啟錄影資料夾"
                                    Click="OnOpenRecordingFolderClick" />
                            <Button Content="瀏覽"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="OnBrowseRecordingDirectoryClick" />
                        </StackPanel>
                        <TextBox x:Name="RecordingDirBox" />
                    </DockPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <TextBlock Text="幀率" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="RecordingFrameRateCombo" Width="100" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="視訊位元率" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="RecordingBitrateCombo"
                                      Width="130"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                            <TextBlock Text="開始延遲" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="RecordingDelayCombo" Width="100" />
                            <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </WrapPanel>

                    <CheckBox x:Name="RecordingCursorCheck"
                              Content="錄製滑鼠游標（Windows 10 2004 以上）"
                              Margin="0,12,0,0" />
                    <CheckBox x:Name="RecordingSystemAudioCheck"
                              Content="錄製電腦播放的聲音（不包含麥克風）"
                              Margin="0,8,0,0"
                              Checked="OnRecordingSystemAudioChanged"
                              Unchecked="OnRecordingSystemAudioChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="系統音訊音量" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="RecordingSystemAudioGainCombo"
                                  Width="120"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value" />
                    </StackPanel>
                    <TextBlock Text="視窗錄影開始後若調整所選視窗大小或將視窗最小化，錄影會自動停止。&#x0A;全螢幕錄影無此限制。"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="關於" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Clippings 剪貼簿 2" Margin="0,12,0,0" />
                    <TextBlock x:Name="VersionText"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,4">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left" Orientation="Horizontal">
                <Button x:Name="SaveButton"
                        Content="儲存設定"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnSaveClick" />
                <TextBlock x:Name="DirtyText"
                           Text="尚未儲存"
                           Foreground="{DynamicResource FavoriteBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <TextBlock x:Name="MessageText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
