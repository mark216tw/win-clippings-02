<Window x:Class="Clippings.App.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clippings 擷取"
        Icon="/Assets/clippings.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        AllowsTransparency="False"
        Background="Black"
        WindowStartupLocation="Manual"
        Cursor="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        SizeChanged="OnSizeChanged"
        Closed="OnClosed"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseRightButtonDown="OnMouseRightButtonDown"
        LostMouseCapture="OnLostMouseCapture">

    <Grid x:Name="RootGrid" Background="Black">
        <Image x:Name="FrozenImage" Panel.ZIndex="0" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />

        <Canvas x:Name="DimLayer"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="{DynamicResource OverlayDimBrush}" />
            <Rectangle x:Name="DimBottom" Fill="{DynamicResource OverlayDimBrush}" />
            <Rectangle x:Name="DimLeft" Fill="{DynamicResource OverlayDimBrush}" />
            <Rectangle x:Name="DimRight" Fill="{DynamicResource OverlayDimBrush}" />
        </Canvas>

        <Rectangle x:Name="SelectionBorder"
                   Panel.ZIndex="20"
                   Stroke="{DynamicResource AccentBrush}"
                   StrokeThickness="1"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <Canvas x:Name="HandleLayer"
                Panel.ZIndex="21"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

        <Border x:Name="SizeLabel"
                Panel.ZIndex="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource ToolbarBrush}"
                CornerRadius="4"
                Padding="6,3"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText"
                       Foreground="{DynamicResource ToolbarTextBrush}"
                       FontSize="12" />
        </Border>

        <Border x:Name="MagnifierPanel"
                Panel.ZIndex="40"
                Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="152"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel>
                <Border Height="112" CornerRadius="7,7,0,0" ClipToBounds="True">
                    <Image x:Name="MagnifierImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <StackPanel Margin="8,5,8,7">
                    <TextBlock x:Name="MagnifierCoords"
                               Foreground="{DynamicResource ToolbarTextBrush}"
                               FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border x:Name="ColorPreview"
                                Width="14"
                                Height="14"
                                CornerRadius="3"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1" />
                        <TextBlock x:Name="MagnifierColor"
                                   Foreground="{DynamicResource ToolbarTextBrush}"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="ActionBar"
              Panel.ZIndex="50"
              Visibility="Collapsed"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Cursor="Arrow"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              MouseEnter="OnActionBarMouseEnter"
              MouseLeave="OnActionBarMouseLeave">
            <Border Background="{DynamicResource ToolbarBrush}"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
                </Border.Effect>
            </Border>
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <Button Content="確定"
                            ToolTip="確定並在 Clippings 編輯器中開啟 (Enter)"
                            Style="{StaticResource OverlayToolbarButtonStyle}"
                            Click="OnConfirmClick" />
                    <Border Width="1" Margin="4,4" Background="#33FFFFFF" />
                    <Button Content="取消"
                            ToolTip="清除選取範圍，回到框選前狀態 (Esc)"
                            Style="{StaticResource OverlayToolbarButtonStyle}"
                            Click="OnCancelClick" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="CaptureHint"
                Panel.ZIndex="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,8"
                IsHitTestVisible="False">
            <TextBlock Text="拖曳選擇範圍；按住 Shift 拖曳為正方形；選取後可用方向鍵微調（Shift 每次 10px）　·　Enter 確定　·　Esc 清除選取；無選取時離開"
                       Foreground="{DynamicResource ToolbarTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxWidth="760" />
        </Border>

        <Canvas x:Name="CursorLayer" Panel.ZIndex="70" IsHitTestVisible="False" Visibility="Collapsed">
            <Line x:Name="CursorHaloH1" Stroke="#D9FFFFFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorHaloH2" Stroke="#D9FFFFFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorHaloV1" Stroke="#D9FFFFFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorHaloV2" Stroke="#D9FFFFFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorCoreH1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorCoreH2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorCoreV1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line x:Name="CursorCoreV2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
    </Grid>
</Window>

