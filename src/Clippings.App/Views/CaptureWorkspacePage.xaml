<UserControl x:Class="Clippings.App.Views.CaptureWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:Clippings.App.Strings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="HeaderImageSizeText"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderZoomText"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <Button x:Name="ActualPixelsButton"
                        Content="{x:Static strings:AppStrings.ActionActualPixels}"
                        Style="{StaticResource EditorActionButtonStyle}"
                        Margin="8,0,0,0"
                        Click="OnActualPixelsClick"
                        ToolTip="{x:Static strings:AppStrings.ActualPixelsToolTip}"
                        AutomationProperties.Name="{x:Static strings:AppStrings.ActualPixelsToolTip}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static strings:AppStrings.WorkspaceTitle}" Style="{StaticResource PageTitleStyle}" />
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="9,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Style="{StaticResource CaptionStyle}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CanvasBackdropBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Static strings:AppStrings.WorkspaceEmpty}"
                               Style="{StaticResource BodySecondaryStyle}"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Content="{x:Static strings:AppStrings.CaptureRegion}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnCaptureRegionClick" />
                        <Button Content="{x:Static strings:AppStrings.CaptureFullScreen}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="OnCaptureFullScreenClick" />
                        <Button Content="{x:Static strings:AppStrings.ActionOpenImage}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="OnEmptyOpenImageClick"
                                ToolTip="{x:Static strings:AppStrings.OpenImageToolTip}"
                                AutomationProperties.Name="{x:Static strings:AppStrings.ActionOpenImage}">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{x:Static strings:AppStrings.OpenFromClipboard}"
                                              Click="OnEmptyOpenFromClipboardClick" />
                                    <MenuItem Header="{x:Static strings:AppStrings.OpenFromFile}"
                                              Click="OnEmptyOpenFileClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Style="{StaticResource CaptionStyle}"
                   Margin="0,6,0,0" />

        <Grid x:Name="Toast"
              Grid.RowSpan="3"
              Panel.ZIndex="10"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,32"
              Visibility="Collapsed"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3" Color="#000000" />
                </Border.Effect>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,8"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText"
                               FontSize="13"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="ToastActionButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="14,0,0,0"
                            Padding="12,5"
                            Click="OnToastActionClick" />
                    <Button x:Name="ToastCloseButton"
                            Content="×"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="6,0,0,0"
                            ToolTip="{x:Static strings:AppStrings.WorkspaceToastDismiss}"
                            AutomationProperties.Name="{x:Static strings:AppStrings.WorkspaceToastDismiss}"
                            Click="OnToastCloseClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
