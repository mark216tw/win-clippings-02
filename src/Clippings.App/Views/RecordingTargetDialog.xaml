<Window x:Class="Clippings.App.Views.RecordingTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:Clippings.App.Strings"
        Title="選擇錄影視窗"
        Width="620"
        Height="480"
        MinWidth="480"
        MinHeight="360"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/clippings.ico"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="選擇錄影視窗" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="只列出目前可見且未最小化的外部視窗。"
                       Style="{StaticResource BodySecondaryStyle}"
                       Margin="0,4,0,4" />
            <TextBlock Text="{x:Static strings:AppStrings.RecordingResizeWarning}"
                       Style="{StaticResource CaptionStyle}"
                       Foreground="{DynamicResource DangerBrush}"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8">
            <Grid>
                <ListBox x:Name="TargetList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnTargetDoubleClick"
                         AutomationProperties.Name="可錄製視窗清單">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProcessName}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText"
                           Text="找不到可錄製的視窗。請先開啟目標視窗後重新整理。"
                           Style="{StaticResource BodySecondaryStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="重新整理"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="OnRefreshClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button x:Name="ConfirmButton"
                        Content="選擇並繼續"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
