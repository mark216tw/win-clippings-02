<Window x:Class="Clippings.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:Clippings.App.Strings"
        Title="{x:Static strings:AppStrings.AppName}"
        Width="1120"
        Height="740"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/clippings.ico"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="{StaticResource ClippingsMarkImage}"
                           Width="32"
                           Height="32"
                           Stretch="Uniform"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Clippings" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="剪貼簿 2" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快速擷取" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                             <Button x:Name="RegionCaptureButton"
                                     Content="區域擷取"
                                     Style="{StaticResource PrimaryButtonStyle}"
                                     Margin="0,8,0,0"
                                     Tag="Region"
                                     ToolTip="區域擷取"
                                     AutomationProperties.Name="區域擷取"
                                     Click="OnCaptureClick" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button x:Name="FullScreenCaptureButton"
                                        Content="全螢幕"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="FullScreen"
                                        ToolTip="全螢幕擷取"
                                        AutomationProperties.Name="全螢幕擷取"
                                        Click="OnCaptureClick" />
                                <Button x:Name="MonitorCaptureButton"
                                        Content="目前螢幕"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="Monitor"
                                        ToolTip="目前螢幕擷取"
                                        AutomationProperties.Name="目前螢幕擷取"
                                        Click="OnCaptureClick" />
                                <Button x:Name="WindowCaptureButton"
                                        Content="目前視窗"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="Window"
                                        ToolTip="目前視窗擷取"
                                        AutomationProperties.Name="目前視窗擷取"
                                        Click="OnCaptureClick" />
                                <Button x:Name="DelayedCaptureButton"
                                        Content="延遲"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="Delayed"
                                        ToolTip="延遲擷取"
                                        AutomationProperties.Name="延遲擷取"
                                        Click="OnCaptureClick" />
                            </UniformGrid>
                             <TextBlock x:Name="HotkeyWarning"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static strings:AppStrings.ScreenAnnotation}" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                            <Button x:Name="ScreenAnnotationButton"
                                    Content="{x:Static strings:AppStrings.ScreenAnnotation}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,8,0,0"
                                    Click="OnScreenAnnotationClick"
                                    ToolTip="{x:Static strings:AppStrings.ScreenAnnotationToolTip}"
                                    AutomationProperties.Name="{x:Static strings:AppStrings.ScreenAnnotation}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="螢幕錄影" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                            <TextBlock x:Name="RecordingStatusText"
                                       Text="尚未錄影"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <Button x:Name="FullScreenRecordingButton"
                                    Content="全螢幕錄影"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,8,0,0"
                                    Click="OnFullScreenRecordingClick" />
                            <Button x:Name="SelectWindowRecordingButton"
                                    Content="選擇視窗錄影"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,6,0,0"
                                    Click="OnSelectWindowRecordingClick" />
                            <Button x:Name="RecordingActionButton"
                                    Content="開始錄影"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed"
                                    Click="OnRecordingActionClick" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button x:Name="OpenRecordingButton"
                                        Content="開啟影片"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="OnOpenRecordingClick" />
                                <Button x:Name="OpenRecordingFolderButton"
                                        Content="開啟資料夾"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="OnOpenRecordingFolderClick" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ExitAppButton"
                            Content="{x:Static strings:AppStrings.ExitApp}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,4"
                            Click="OnExitAppClick"
                            ToolTip="{x:Static strings:AppStrings.ExitAppToolTip}"
                            AutomationProperties.Name="結束 Clippings" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         SelectionChanged="OnNavSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBoxItem Content="擷圖" Style="{StaticResource NavItemStyle}" />
                    <ListBoxItem Content="設定" Style="{StaticResource NavItemStyle}" />
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="24,20,24,0" />
    </Grid>
</Window>

