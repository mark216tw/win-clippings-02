<Window x:Class="Clippings.App.Views.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="錄影控制"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        DpiChanged="OnDpiChanged"
        SizeChanged="OnSizeChanged"
        Closed="OnClosed">
    <Grid Margin="18" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Background="{DynamicResource ToolbarBrush}"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
            </Border.Effect>
        </Border>
        <Border Background="Transparent"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="10"
                         Height="10"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource DangerBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ElapsedText"
                               Text="00:00:00"
                               FontFamily="Consolas"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ToolbarTextBrush}" />
                    <TextBlock x:Name="StateText"
                               Text="錄影中"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Opacity="0.78"
                               Foreground="{DynamicResource ToolbarTextBrush}" />
                </StackPanel>

                <TextBlock x:Name="TargetText"
                            Grid.Column="2"
                           MaxWidth="260"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource ToolbarTextBrush}"
                            Opacity="0.86"
                            TextTrimming="CharacterEllipsis"
                            MouseLeftButtonUp="OnTargetTextMouseLeftButtonUp" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseResumeButton"
                            Style="{StaticResource AnnotateIconButtonStyle}"
                            Click="OnPauseResumeClick"
                            AutomationProperties.Name="暫停錄影">
                        <Viewbox Width="14" Height="14">
                            <Path x:Name="PauseResumeIcon"
                                  Width="14"
                                  Height="14"
                                  Fill="{DynamicResource ToolbarTextBrush}"
                                  Data="M2,1 L5,1 L5,13 L2,13 Z M9,1 L12,1 L12,13 L9,13 Z" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="StopButton"
                            Style="{StaticResource AnnotateIconButtonStyle}"
                            Click="OnStopClick"
                            AutomationProperties.Name="停止錄影">
                        <Viewbox Width="12" Height="12">
                            <Path Width="12"
                                  Height="12"
                                  Fill="{DynamicResource ToolbarTextBrush}"
                                  Data="M2,2 L12,2 L12,12 L2,12 Z" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
