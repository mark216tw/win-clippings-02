<Window x:Class="Clippings.App.Views.RecordingCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="錄影倒數"
        Width="240"
        MinWidth="240"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="Manual"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Background="{DynamicResource SurfaceBrush}"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.42" Color="#000000" />
            </Border.Effect>
        </Border>
        <Border Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="錄影將在" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="SecondsText"
                           Text="5"
                           FontSize="64"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource FavoriteBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,-4,0,-2" />
                <TextBlock Text="秒後開始" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                <Button Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Click="OnCancelClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
